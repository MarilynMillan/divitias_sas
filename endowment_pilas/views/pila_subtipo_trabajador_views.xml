<?xml version="1.0" encoding="utf-8"?>
<odoo>
   
    <!-- Vistas para pila.subtipo.trabajador -->
    <record id="view_pila_subtipo_trabajador_tree" model="ir.ui.view">
        <field name="name">pila.subtipo.trabajador.tree</field>
        <field name="model">pila.subtipo.trabajador</field>
        <field name="arch" type="xml">
            <list string="Subtipos de Cotizante">
                 <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pila_subtipo_trabajador_form" model="ir.ui.view">
        <field name="name">pila.subtipo.trabajador.form</field>
        <field name="model">pila.subtipo.trabajador</field>
        <field name="arch" type="xml">
            <form string="Subtipos de Cotizante">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="code"/>
                             <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pila_subtipo_trabajador" model="ir.actions.act_window">
        <field name="name">Subtipos Cotizantes</field>
        <field name="res_model">pila.subtipo.trabajador</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_subcotizante"
              name="Subtipos Cotizantes"
              parent="hr_payroll.menu_hr_payroll_global_settings"
              action="action_pila_subtipo_trabajador"
              sequence="63"/>

</odoo>