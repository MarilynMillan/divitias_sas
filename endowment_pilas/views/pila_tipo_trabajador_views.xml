<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vistas para pila.tipo.trabajador -->
    <record id="view_pila_tipo_trabajador_tree" model="ir.ui.view">
        <field name="name">pila.tipo.trabajador.tree</field>
        <field name="model">pila.tipo.trabajador</field>
        <field name="arch" type="xml">
            <list string="Cotizante">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pila_tipo_trabajador_form" model="ir.ui.view">
        <field name="name">pila.tipo.trabajador.form</field>
        <field name="model">pila.tipo.trabajador</field>
        <field name="arch" type="xml">
            <form string="Cotizante">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="code"/>
                             <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pila_tipo_trabajador" model="ir.actions.act_window">
        <field name="name">Cotizantes</field>
        <field name="res_model">pila.tipo.trabajador</field>
        <field name="view_mode">list,form</field>
    </record>



    <menuitem id="menu_cotizante"
              name="Cotizantes"
              parent="hr_payroll.menu_hr_payroll_global_settings"
              action="action_pila_tipo_trabajador"
              sequence="60"/>

    
</odoo>
